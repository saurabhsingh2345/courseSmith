# Build output
bin/
dist/
studio/dist/
studio/node_modules/

# Local engine state: LLM response cache + rate-limit bookkeeping.
# Machine-local by design — a fresh clone regenerates it.
.coursesmith/

# Hugo build output
site/public/
site/resources/

# Remotion renderer: dependencies, staged render/preview assets, outputs
renderer/node_modules/
renderer/public/jobs/
renderer/public/preview/
renderer/out/
# ...and its downloaded headless-browser caches (150MB+ binaries)
.remotion/
test/.remotion/

# whisperX alignment tool virtualenv
tools/align/.venv/

# Generated media is large and reproducible; generated text artifacts
# (script.json, quiz.json, alignment.json, captions.vtt, reviews/,
# diagrams/*.svg, lesson-video.json) stay versionable. Remove these lines
# if you prefer committing media too.
courses/*/lessons/*/generated/audio/
courses/*/lessons/*/generated/video-segments/
courses/*/lessons/*/generated/demos/*.mp4
courses/*/lessons/*/generated/diagrams/attempts/*.png
courses/*/lessons/*/generated/voiceover.wav
courses/*/lessons/*/generated/final.mp4
courses/*/lessons/*/generated/final-burned.mp4
courses/*/lessons/*/generated/sections/
courses/*/course.mp4
courses/*/generated/*.pdf
courses/*/generated/*-ebook.html
# Voice auditions: the clips and the player page that links them are one
# regenerable unit — `coursesmith audition <course>` rebuilds both.
courses/*/auditions/
# Videos stay out of the repo; the deploy workflow serves the site without
# them (set the videoBaseURL site param to point at a CDN — see
# .github/workflows/deploy-site.yml).
site/content/courses/*/*/final.mp4

# OS noise
.DS_Store

# Finished snippet videos copied out of the .coursesmith cache — generated output,
# and large.
videos/

# Remaster: the footage it crops from, the voice it lays under it, and the
# per-beat clips `build_voice.py` cuts on the way there. Half a gigabyte, all of
# it either downloaded or regenerated by that script from edl.ts.
renderer/public/remaster/
renderer/src/remaster/.voice/

# Social film: the same split as remaster. The narration bed and the per-beat
# clips `build_voice.py` cuts from it are half a gigabyte of regenerable audio,
# and public/lumen is just demo/lumen's photos staged where Remotion can serve
# them — `cp -R demo/lumen/img/* renderer/public/lumen/` puts them back.
renderer/public/social/
renderer/public/lumen/
renderer/src/social/.voice/

# Editor backups left beside a file mid-edit.
*.bak

# ---------------------------------------------------------------------------
# No-code program: the rigs are versioned, the footage is not.
# ---------------------------------------------------------------------------
# Every shoot under tools/nocode/ writes tens of gigabytes of takes, voice and
# frames next to the script that produced it. The scripts, beat sheets and
# decks are the source of truth and stay in the repo; the media is local-only
# and a re-run of the rig regenerates it. Media lives beside code here rather
# than in one folder, so the rule is by extension first, staging dir second.

# Captures, renders, and every voice bed cut from them.
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.wav
*.m4a
*.aac
*.flac
# Kit archives passed between the two Macs (see tools/nocode/sync).
*.zip

# Remotion staging: clips and voice-over staged where the renderer serves them.
# `renderer/public/jobs|preview|remaster|social|lumen` are covered above.
renderer/public/demo/
renderer/public/nocode*/
renderer/public/tutorial*/
# The content-addressed voice store each composition builds beside its source.
renderer/src/*/.voice/

# Shoot rigs: raw takes, the assembled intermediates, and the extracted frames.
tools/nocode/**/takes/
tools/nocode/**/captures/
tools/nocode/**/cuts/
tools/nocode/**/frames/
tools/nocode/**/_assemble/
tools/nocode/**/_voice/
tools/nocode/**/logs/
tools/nocode/**/vids/
# The throwaway Chrome profile a shoot drives — browsing state, not source.
tools/nocode/**/.shootprofile/
# An unpacked kit archive: a vendored virtualenv plus macOS resource forks.
tools/nocode/nc/__MACOSX/

# Python bytecode and virtualenvs, wherever a rig leaves them.
__pycache__/
*.pyc
.venv/

# Shoot screenshots and probe frames: these are pictures of a real screen, so
# they are both large and the most likely place for a name or an email to slip
# into the repo (see tools/nocode/w3/autoredact.py for why that matters).
tools/nocode/**/*.png
tools/nocode/**/*.jpg
tools/nocode/**/*.jpeg
# Shoot run logs and the scratch copies a rig leaves beside an edited file.
tools/nocode/**/*.log
tools/nocode/**/*.before
tools/nocode/**/*.thin
tools/nocode/**/*.old

# A shoot swaps the real Claude Code settings out and parks them here so the
# teardown can put them back. Personal config, not part of the rig.
tools/nocode/**/claude-settings.backup.json
# Per-shoot staging: the text-keyed voice cache and the part lists an assemble
# writes on its way to a cut. Regenerated by the rig on the next run.
tools/nocode/**/_work/
tools/nocode/**/_prefetch/
tools/nocode/**/_voice_liam/
tools/nocode/**/_montage/

# What a shoot snapshots so teardown can put the machine back: display layout,
# window positions, menubar state, and the real VS Code and plugin settings it
# swapped out. Written fresh at the start of every shoot, and a picture of this
# machine rather than part of the rig.
tools/nocode/**/restore/
# Same idea one directory over: the real editor settings and the original
# statusline script a shoot replaces, parked so teardown can restore them.
tools/nocode/**/*.backup.json
tools/nocode/**/*.ORIGINAL.*
