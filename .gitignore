# Build output
bin/
dist/
studio/dist/
studio/node_modules/

# Local engine state: LLM response cache + rate-limit bookkeeping.
# Machine-local by design — a fresh clone regenerates it.
.coursesmith/

# Hugo build output
site/public/
site/resources/

# Remotion renderer: dependencies, staged render/preview assets, outputs
renderer/node_modules/
renderer/public/jobs/
renderer/public/preview/
renderer/out/
# ...and its downloaded headless-browser caches (150MB+ binaries)
.remotion/
test/.remotion/

# whisperX alignment tool virtualenv
tools/align/.venv/

# Generated media is large and reproducible; generated text artifacts
# (script.json, quiz.json, alignment.json, captions.vtt, reviews/,
# diagrams/*.svg, lesson-video.json) stay versionable. Remove these lines
# if you prefer committing media too.
courses/*/lessons/*/generated/audio/
courses/*/lessons/*/generated/video-segments/
courses/*/lessons/*/generated/demos/*.mp4
courses/*/lessons/*/generated/diagrams/attempts/*.png
courses/*/lessons/*/generated/voiceover.wav
courses/*/lessons/*/generated/final.mp4
courses/*/lessons/*/generated/final-burned.mp4
courses/*/lessons/*/generated/sections/
courses/*/course.mp4
courses/*/generated/*.pdf
courses/*/generated/*-ebook.html
# Voice auditions: the clips and the player page that links them are one
# regenerable unit — `coursesmith audition <course>` rebuilds both.
courses/*/auditions/
# Videos stay out of the repo; the deploy workflow serves the site without
# them (set the videoBaseURL site param to point at a CDN — see
# .github/workflows/deploy-site.yml).
site/content/courses/*/*/final.mp4

# OS noise
.DS_Store

# Finished snippet videos copied out of the .coursesmith cache — generated output,
# and large.
videos/

# Remaster: the footage it crops from, the voice it lays under it, and the
# per-beat clips `build_voice.py` cuts on the way there. Half a gigabyte, all of
# it either downloaded or regenerated by that script from edl.ts.
renderer/public/remaster/
renderer/src/remaster/.voice/

# Social film: the same split as remaster. The narration bed and the per-beat
# clips `build_voice.py` cuts from it are half a gigabyte of regenerable audio,
# and public/lumen is just demo/lumen's photos staged where Remotion can serve
# them — `cp -R demo/lumen/img/* renderer/public/lumen/` puts them back.
renderer/public/social/
renderer/public/lumen/
renderer/src/social/.voice/

# Editor backups left beside a file mid-edit.
*.bak
