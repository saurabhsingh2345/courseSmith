Output "/Users/enfecsolutions/Desktop/enfec_subs/courseSmith/courses/no-code/lessons/05-when-you-outgrow-the-browser/generated/demos/capture-1.mp4"
Set FontSize 34
Set Width 1440
Set Height 640
Set Padding 32
Set TypingSpeed 80ms
Set Shell bash
Set Theme { "background": "#0a0715", "foreground": "#f2f2f8", "cursor": "#f5c26b", "yellow": "#f5c26b", "brightYellow": "#f5c26b" }
Set WaitTimeout 10m

Type "ls"
Enter
Sleep 2s
# MARK project-open
Type "claude -p 'Add a weekly summary feature to the habit tracker'"
Enter
Sleep 1s
Wait
Sleep 2s
# MARK feature-added
Type "ls"
Enter
Sleep 2s
# MARK files-changed
Type "cat README.md"
Enter
Sleep 2s
# MARK readme-content
Sleep 3s
