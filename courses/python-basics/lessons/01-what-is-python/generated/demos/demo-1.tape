Output demos/demo-1.mp4
Set FontSize 34
Set Width 1440
Set Height 640
Set Padding 32
Set TypingSpeed 80ms
Set Shell bash
Set Theme { "background": "#070c15", "foreground": "#f2f5f8", "cursor": "#ffd43b", "yellow": "#ffd43b", "brightYellow": "#ffd43b" }

Type "python3"
Enter
Sleep 1s
Type "print('Hello, world!')"
Enter
Sleep 2s
Type "print('Ada')"
Enter
Sleep 2s
Type "exit()"
Enter
