Output demos/demo-1.mp4
Set FontSize 34
Set Width 1440
Set Height 640
Set Padding 32
Set TypingSpeed 80ms
Set Shell bash
Set Theme { "background": "#070815", "foreground": "#f2f4f8", "cursor": "#f59e0b", "yellow": "#f59e0b", "brightYellow": "#f59e0b" }

Type "cat > demo.py << 'EOF'"
Enter
Type "fruits = ['apple', 'banana', 'cherry']"
Enter
Type "for fruit in fruits:"
Enter
Type "    print(fruit)"
Enter
Type "EOF"
Enter
Type "python3 demo.py"
Enter
Sleep 1s
Sleep 2s
Type "cat > demo.py << 'EOF'"
Enter
Type "count = 0"
Enter
Type "while count < 5:"
Enter
Type "    print(count)"
Enter
Type "    count += 1"
Enter
Type "EOF"
Enter
Type "python3 demo.py"
Enter
Sleep 1s
Sleep 2s
Sleep 3s
