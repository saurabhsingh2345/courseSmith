Output demos/demo-1.mp4
Set FontSize 34
Set Width 1440
Set Height 640
Set Padding 32
Set TypingSpeed 80ms
Set Shell bash
Set Theme { "background": "#070815", "foreground": "#f2f4f8", "cursor": "#f59e0b", "yellow": "#f59e0b", "brightYellow": "#f59e0b" }

Type "python3"  
Enter  
Sleep 1s  
Type "print('I love Python!')"  
Enter  
Sleep 2s  

Type "print('Hello, World!')"  
Enter  
Sleep 2s  

Type "print('Hello', 'World!')"  
Enter  
Sleep 2s  

Type "print(5 + 3)"  
Enter  
Sleep 2s  

Type "exit()"  
Enter  
Sleep 3s
